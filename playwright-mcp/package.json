{
  "name": "playwright-mcp-quality-engineering",
  "version": "1.0.0",
  "description": "Playwright test automation project with Playwright MCP integration for AI-assisted quality engineering",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --project=chromium --debug",
    "report": "playwright show-report",
    "codegen": "playwright codegen",
    "trace": "playwright show-trace"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.53.0",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0"
  }
}
